license: "MIT OR Apache-2.0"
keywords:
  - "Rust"
  - "Speculative Decoding"
  - "PagedAttention"
  - "KV-Cache"
  - "LLM"
  - "Inference Engine"
  - "Tree Decoding"
  - "Medusa"
  - "Eagle"
  - "OpenAI API"
